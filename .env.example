# نمونه متغیرهای محیطی — فایل واقعی را .env.local بنامید (.env* در .gitignore است و هرگز commit نشود)

# ذخیره‌سازی دائمی داده در Supabase (PostgreSQL):
# این دو متغیر را در Vercel (Settings → Environment Variables) و برای اجرای محلی
# در .env.local بگذارید. schema دیتابیس: supabase/migrations/
# اگر خالی باشند (اجرای محلی بدون دیتابیس)، داده در فایل data/db.json ذخیره می‌شود.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
